# Copy this file to .env and fill in real values. .env is gitignored — never commit it.

# Required by the standards/chat/report endpoints (not by /api/predict-risk,
# which is pure ML inference and needs no API key).
ANTHROPIC_API_KEY=

# Comma-separated list of allowed CORS origins for the local React dev server.
# Defaults to http://localhost:5173,http://localhost:3000 if unset.
ALLOWED_ORIGINS=http://localhost:5173,http://localhost:3000
