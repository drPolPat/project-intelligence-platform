# Copy this file to .env and fill in a real value. .env is gitignored — never
# commit it. This server's OWN key, per the isolated-environment design — not
# read from the main project's .env, even though it's the same secret.

# Required by query_standards and draft_risk_report (not by predict_risk_score,
# which is pure ML inference and needs no API key).
ANTHROPIC_API_KEY=
